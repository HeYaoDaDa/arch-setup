[Unit]
Description=SSH port forward ({{ ssh_forward_port }} -> {{ ssh_forward_target }}:{{ ssh_forward_target_port | default('22') }})
After=network.target
Before=sshd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nft add table ip ssh_forward
ExecStart=/usr/bin/nft add chain ip ssh_forward prerouting { type nat hook prerouting priority dstnat \; policy accept \; }
ExecStart=/usr/bin/nft add rule ip ssh_forward prerouting tcp dport {{ ssh_forward_port }} dnat to {{ ssh_forward_target }}:{{ ssh_forward_target_port | default('22') }}
ExecStart=/usr/bin/nft add chain ip ssh_forward postrouting { type nat hook postrouting priority srcnat \; policy accept \; }
ExecStart=/usr/bin/nft add rule ip ssh_forward postrouting ip daddr {{ ssh_forward_target }} tcp dport {{ ssh_forward_target_port | default('22') }} snat to {{ static_ip }}
ExecStart=/usr/bin/nft add chain ip ssh_forward forward { type filter hook forward priority 0 \; policy accept \; }

ExecStop=/usr/bin/nft delete table ip ssh_forward

[Install]
WantedBy=multi-user.target
